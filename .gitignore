```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.Pytest_cache/

# Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled Binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out
```